# ===========================================================================
# Multilingual file for the TOS 7 Docker application "duckdnsdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "DuckDNS"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "DuckDNS is a free dynamic DNS service. It keeps a name like mynas.duckdns.org pointed at the public IP of your NAS, so you can reach it when your ISP changes that address. This package runs the official LinuxServer.io DuckDNS client, which checks the address every few minutes and calls the DuckDNS API when it changes. A built-in page lets you enter the subdomain and token and shows the last update result. The container runs as a non-root user and keeps its settings and log in the application data folder."
release_note = "1. First release: the official LinuxServer.io DuckDNS client packaged for TOS 7. Runs as a non-root container, includes a status and setup page, and keeps the settings, log and last result in the application data folder."
important    = "Requires DockerEngine. Create a domain and token at duckdns.org, then enter the subdomain (without .duckdns.org) and token in the app and save. The token is kept in DockerAppData/duckdnsdocker/config/duckdns.conf (app user only); keep it secret. HTTPS access to duckdns.org is required. It only updates DNS, not firewall ports; remote access still needs port forwarding or a tunnel. The page is plain HTTP with no login; keep it off the internet. Back up the folder before uninstalling with data removal."

[zh-cn]
name         = "DuckDNS"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "DuckDNS 是一个免费的动态域名服务。它把 mynas.duckdns.org 这样的域名始终指向 NAS 的公网 IP，运营商更换地址后依然可以从外网访问。本应用运行 LinuxServer.io 官方 DuckDNS 客户端，每隔几分钟检测一次地址，地址变化时调用 DuckDNS 更新接口。内置页面可以填写子域名与 Token，并显示最近一次更新的结果。容器以非 root 用户运行，设置与日志都保存在应用数据目录。"
release_note = "1. 首个版本：把 LinuxServer.io 官方 DuckDNS 客户端封装为 TOS 7 应用。以非 root 用户运行，内置状态与设置页面；设置、日志和最近一次结果都保存在应用数据目录。"
important    = "需要 DockerEngine。请先在 duckdns.org 创建域名并取得 Token，然后在应用页面填写子域名（不含 .duckdns.org）与 Token 并保存。Token 保存在 DockerAppData/duckdnsdocker/config/duckdns.conf，仅应用用户可读，请按密钥保管。应用需要访问 duckdns.org 的 HTTPS。它只更新 DNS，不开放防火墙端口；外网访问仍需端口转发或内网穿透。页面是局域网内的明文 HTTP 且没有登录，请勿暴露到公网。卸载并删除数据前请备份该目录。"

[zh-hk]
name         = "DuckDNS"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "DuckDNS 是一個免費的動態域名服務。它把 mynas.duckdns.org 這樣的域名始終指向 NAS 的公網 IP，即使網路供應商更換位址，仍可從外網存取。本應用執行 LinuxServer.io 官方 DuckDNS 用戶端，每隔幾分鐘偵測一次位址，位址變更時呼叫 DuckDNS 更新介面。內建頁面可以填寫子域名與 Token，並顯示最近一次更新的結果。容器以非 root 使用者執行，設定與日誌都儲存在應用程式資料目錄。"
release_note = "1. 首個版本：把 LinuxServer.io 官方 DuckDNS 用戶端封裝為 TOS 7 應用。以非 root 使用者執行，內建狀態與設定頁面；設定、日誌和最近一次結果都儲存在應用程式資料目錄。"
important    = "需要 DockerEngine。請先在 duckdns.org 建立域名並取得 Token，然後在應用頁面填寫子域名（不含 .duckdns.org）與 Token 並儲存。Token 儲存在 DockerAppData/duckdnsdocker/config/duckdns.conf，僅應用程式使用者可讀，請視同密鑰保管。應用需要存取 duckdns.org 的 HTTPS。它只更新 DNS，不開放防火牆連接埠；外網存取仍需連接埠轉送或內網穿透。頁面是區域網路內的明文 HTTP 且沒有登入，請勿暴露到公網。解除安裝並刪除資料前請備份該目錄。"

